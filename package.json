{
  "name": "mini-claude-code",
  "version": "0.0.53",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "test:tools": "cd examples/mini-claude-code && node --import tsx --test test/tools.test.ts",
    "check:links": "node scripts/check-links.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check": "pnpm types:check && pnpm --dir examples/mini-claude-code typecheck && pnpm test:tools && pnpm check:links && pnpm check:snippets && pnpm build"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.10",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
